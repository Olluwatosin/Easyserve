DATABASE_URL=postgresql+asyncpg://user:password@host:5432/easyserve
REDIS_URL=redis://localhost:6379
SECRET_KEY=change-this-to-a-random-32-char-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
# Durable storage and CDN delivery for menu photos. Copy this from the
# Cloudinary dashboard — it is the "API environment variable" there, in the form
# cloudinary://<api_key>:<api_secret>@<cloud_name>.
#
# Leave it empty to use local disk, which is correct for development and for a
# VPS with a real volume. On a container host (Render, Fly, Heroku) local disk
# is wiped on every deploy and every photo an owner uploaded is lost.
# /health reports which store is in use.
CLOUDINARY_URL=
CLOUDINARY_FOLDER=easyserve/menu
EXIT_PASS_DEFAULT_MINUTES=10
# Where a guest is sent back to after paying, and the address printed QR codes
# point at. Must match the frontend's own origin — a mismatch means payment
# succeeds and the guest lands on a dead page, which reads as losing their money.
FRONTEND_URL=http://localhost:3000
# Paystack pay-by-transfer (leave empty to disable online payments)
PAYSTACK_SECRET_KEY=
# Optional Sentry error tracking
SENTRY_DSN=
# Password reset email. Leave empty in dev — the link is logged instead.
RESEND_API_KEY=
MAIL_FROM=EasyServe <noreply@easyserve.ng>
PASSWORD_RESET_EXPIRE_MINUTES=30
# WhatsApp password recovery (Meta Cloud API). Empty = code logged, not sent.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_RESET_TEMPLATE=password_reset
PASSWORD_RESET_CODE_EXPIRE_MINUTES=10
# Public demo only — enables POST /api/v1/demo/reset.
# Requires ENVIRONMENT=demo as well; ignored entirely in production.
DEMO_RESET_TOKEN=
ENVIRONMENT=development
# Comma-separated, no spaces after the commas: the value is split on "," and
# each entry compared exactly, so ", https://…" never matches.
ALLOWED_ORIGINS=http://localhost:3000,https://easyserveng.com,https://www.easyserveng.com
